# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# META_ACCESS_TOKEN: Optional server-side Meta Graph API User/System token
# for fetching Facebook Pages and publishing scheduled posts automatically.
META_ACCESS_TOKEN=""

# GITHUB_TOKEN: Optional GitHub Personal Access Token (repo scope)
# for pushing updates directly to your GitHub repository from the Deploy Console.
GITHUB_TOKEN=""
